# Hostname or IP of the Fronius inverter (Solar API v1 must be enabled)
FRONIUS_HOST=192.168.1.100

# Location for the sun altitude in the "Energy Usage" panel (Sun and Moon datasource)
LATITUDE=48.2
LONGITUDE=16.37

# Optional, only with `--profile forecast`:
# https://api.forecast.solar/estimate/watthours/<lat>/<lon>/<declination>/<azimuth>/<kWp>?time=utc
FORECAST_URL=

GRAFANA_ADMIN_PASSWORD=change-me
